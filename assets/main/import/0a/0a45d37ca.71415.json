lass","count":10}],"spawn":[],"island":{"x":125,"width":96,"height":150}},{"id":"slots","name":"Слот-машина","description":"За монеты случайно выдаёт артефакт, ресурс или свиток. Вращение — 5 монет.","sprite":"bubble","tint":"#C44C4C","craftCost":50,"unlockQuest":"craft-slots","ingredients":[{"type":"plank","count":10},{"type":"scrap","count":20},{"type":"glass","count":10}],"spawn":[],"island":{"x":20,"width":72,"height":110}}]}]],0,0,[],[],[]],[[[9,"resources",{"version":1,"resources":[{"id":"plank","name":"Доска","description":"Мокрая, но ещё держит гвоздь. Нужна для любой плотницкой работы.","sprite":"plank","carry":{"x":10,"y":5,"angle":-15,"scale":1.2},"spawn":[{"from":0,"weight":0.03,"birds":["seagull"]}]},{"id":"rope","name":"Верёвка","description":"Пеньковая скрутка. Связывает то, что море норовит развязать.","sprite":"rope","carry":{"x":7,"y":5,"angle":-15,"scale":1.2},"spawn":[{"from":0,"weight":0.03,"birds":["seagull"]}]},{"id":"canvas","name":"Парусина","description":"Жёсткое полотно. На кровать, в шкаф и на парус, если доживём.","sprite":"canvas","carry":{"x":10,"y":0,"angle":-75,"scale":1.1},"spawn":[{"from":0,"weight":0.03,"birds":["seagull"]}]},{"id":"scrap","name":"Металлолом","description":"Ржавые обломки. Всё ещё годны на гвоздь, петлю и щель автомата.","sprite":"scrap","carry":{"x":10,"y":0,"angle":35,"scale":1.2},"spawn":[{"from":0,"weight":0.03,"birds":["seagull"]}]},{"id":"glass","name":"Стекло","description":"Старые бытулки из под выпивки служат отличным источником стекла.","sprite":"glass","carry":{"x":5,"y":5,"angle":100,"scale":1.3},"spawn":[{"from":0,"weight":0.03,"birds":["seagull"]}]},{"id":"rotten-bone","name":"Гнилая кость","description":"Хрустит, как сухарь. Пахнет кафедрой мертвецов.","sprite":"rotten-bone","special":true,"carry":{"x":10,"y":5,"angle":-35,"scale":1.2},"spawn":[{"from":0,"weight":0.15,"birds":["zombie"]}]},{"id":"clockwork-spring","name":"Заводная пружина","description":"Всё ещё норовит щёлкнуть пальцы. Добыча сумасшедших чаек.","sprite":"clockwork-spring","special":true,"carry":{"x":7,"y":0,"angle":0,"scale":1},"spawn":[{"from":0,"weight":0.15,"birds":["crazy"]}]},{"id":"ice-shard","name":"Осколок льда","description":"Не тает на ладони. Холод морозной чайки.","sprite":"ice-shard","special":true,"carry":{"x":0,"y":0,"angle":150,"scale":1.1},"spawn":[{"from":0,"weight":0.15,"birds":["freeze"]}]},{"id":"mega-seed","name":"Мега-семя","description":"Странное светящееся семя из неизвестного измерения. Учёный-чайка утверждает, что оно содержит невероятное количество энергии.","sprite":"megaseed","special":true,"carry":{"x":5,"y":0,"angle":80,"scale":1.2},"spawn":[{"from":0,"weight":0.25,"birds":["teleport"]}]},{"id":"ectoplasm","name":"Эктоплазма","description":"Серебристая крупа с крыльев чайки-призрака. Держится в горсти, как дым.","sprite":"ectoplasm","special":true,"carry":{"x":5,"y":0,"angle":10,"scale":1.2},"spawn":[{"from":0,"weight":0.25,"birds":["ghost"]}]},{"id":"gunpowder","name":"Порох","description":"Порох из бомбы солдатской чайки. Сними бомбу прыжком, пока солдат её не сбросил.","sprite":"gunpowder","special":true,"carry":{"x":0,"y":0,"angle":0,"scale":1},"spawn":[]},{"id":"mutagen","name":"Мутаген","description":"Колба учёного. Лучше не разбивать над островом.","sprite":"mutagen","special":true,"carry":{"x":5,"y":0,"angle":20,"scale":1.2},"spawn":[{"from":0,"weight":0.25,"birds":["scientist"]}]},{"id":"stardust","name":"Звёздная пыль","description":"Сыпется со звездочёта. Одна из самых ценных крупиц в рецептах.","sprite":"stardust","special":true,"carry":{"x":5,"y":0,"angle":15,"scale":1.2},"spawn":[{"from":0,"weight":0.25,"birds":["wizard"]}]},{"id":"golden-feather","name":"Золотое перо","description":"Перо золотой чайки. Блестит даже в трюме.","sprite":"golden-feather","special":true,"carry":{"x":5,"y":3,"angle":-60,"scale":1.3},"spawn":[{"from":0,"weight":0.3,"birds":["midas"]}]}]}]],0,0,[],[],[]],[[[9,"quests",{"version":3,"quests":[{"id":"first-chest","title":"Первый сундук","description":"Пятнадцать монет — и на песке появится сундук. Без него добыча уйдёт в прилив.\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":{"type":"collect","coins":true,"count":15},"reward":{"type":"item","item":"chest","place":true},"config":{"coins":{"SPAWN":[{"from":5,"weight":0.05}]}}},{"id":"craft-wardrobe","title":"Крафт шкафа","description":"Три пригоршни эктоплазмы — и я вышлю чертёж шкафа. Призраки носят серебро на крыльях.\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":{"type":"collect","itemId":"ectoplasm","count":3},"reward":{"type":"item","item":"wardrobe"},"config":{"items":{"ectoplasm":{"spawn":[{"from":0,"weight":0.35}]}},"birds":{"ghost":{"SPAWN":[{"from":10,"weight":0.1}]}}}},{"id":"craft-bed","title":"Крафт кровати","description":"У зомби в когтях чертёж кровати. Принеси свиток — доски будут твоими.\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":{"type":"collect","itemId":"bed","count":1},"reward":{"type":"item","item":"plank","count":10},"config":{"items":{"bed":{"spawn":[{"from":0,"weight":0.1,"birds":["zombie"]}]}}}},{"id":"craft-slots","title":"Крафт слот-машины","description":"Пять пружин, десять стёкол, пятнадцать кусков лома, мутаген и три щепотки пороха. За это — чертёж автомата.\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":{"type":"collect","items":[{"itemId":"clockwork-spring","count":5},{"itemId":"glass","count":10},{"itemId":"scrap","count":15},{"itemId":"mutagen","count":1},{"itemId":"gunpowder","count":3}]},"reward":{"type":"item","item":"slots"}}]}]],0,0,[],[],[]],[[{"name":"default_btn_disabled","rect":{"x":0,"y":0,"width":40,"height":40},"offset":{"x":0,"y":0},"originalSize":{"width":40,"height":40},"rotated":false,"capInsets":[12,12,12,12],"vertices":{"rawPosition":[-20,-20,0,20,-20,0,-20,20,0,20,20,0],"indexes":[0,1,2,2,1,3],"uv":[0,40,40,40,0,0,40,0],"nuv":[0,0,1,0,0,1,1,1],"minPos":{"x":-20,"y":-20,"z":0},"maxPos":{"x":20,"y":20,"z":0}},"packable":true,