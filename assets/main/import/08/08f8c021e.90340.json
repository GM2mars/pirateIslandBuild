айно выдаёт артефакт, ресурс или свиток. Вращение — 5 монет.","sprite":"bubble","tint":"#C44C4C","craftCost":50,"unlockQuest":"craft-slots","ingredients":[{"type":"plank","count":10},{"type":"scrap","count":20},{"type":"glass","count":10}],"spawn":{},"island":{"x":20,"width":72,"height":110}}]}]],0,0,[],[],[]],[[[8,"resources",{"version":1,"resources":[{"id":"plank","name":"Доска","description":"Мокрая, но ещё держит гвоздь. Нужна для любой плотницкой работы.","frame":"plank","carry":{"x":5,"y":0,"angle":-30,"scale":1.2},"spawn":{"bird":{"basic":[{"from":5,"to":50,"weight":0.05},{"from":50,"to":100,"weight":0.07},{"from":100,"to":-1,"weight":0.1}]},"egg":{"basic":{"weight":0.7}}}},{"id":"rope","name":"Верёвка","description":"Пеньковая скрутка. Связывает то, что море норовит развязать.","frame":"rope","carry":{"x":7,"y":5,"angle":-15,"scale":1.2},"spawn":{"bird":{"basic":[{"from":5,"to":50,"weight":0.05},{"from":50,"to":100,"weight":0.07},{"from":100,"to":-1,"weight":0.1}]},"egg":{"basic":{"weight":0.7}}}},{"id":"canvas","name":"Парусина","description":"Жёсткое полотно. На кровать, в шкаф и на парус, если доживём.","frame":"canvas","carry":{"x":10,"y":0,"angle":-75,"scale":1.1},"spawn":{"bird":{"basic":[{"from":5,"to":50,"weight":0.05},{"from":50,"to":100,"weight":0.07},{"from":100,"to":-1,"weight":0.1}]},"egg":{"basic":{"weight":0.7}}}},{"id":"scrap","name":"Металлолом","description":"Ржавые обломки. Всё ещё годны на гвоздь, петлю и щель автомата.","frame":"scrap_1","carry":{"x":5,"y":0,"angle":20,"scale":1.2},"spawn":{"bird":{"basic":[{"from":5,"to":50,"weight":0.05},{"from":50,"to":100,"weight":0.07},{"from":100,"to":-1,"weight":0.1}]},"egg":{"basic":{"weight":0.7}}}},{"id":"glass","name":"Стекло","description":"Старые бытулки из под выпивки служат отличным источником стекла.","frame":"glass","carry":{"x":5,"y":5,"angle":55,"scale":1.3},"spawn":{"bird":{"basic":[{"from":5,"to":50,"weight":0.05},{"from":50,"to":100,"weight":0.07},{"from":100,"to":-1,"weight":0.1}]},"egg":{"basic":{"weight":0.7}}}},{"id":"brain","name":"Ожившие мозги","description":"Мозги давно почившего моряка, но еще живые, благодаря неизвестной магии.","frame":"brain","special":true,"carry":{"x":7,"y":0,"angle":-15,"scale":1.1},"spawn":{"bird":{"zombie":[{"from":5,"to":50,"weight":0.15},{"from":50,"to":100,"weight":0.25},{"from":100,"to":-1,"weight":0.3}]},"egg":{"basic":{"weight":0.5}}}},{"id":"strange-shell","name":"Странная раковина","description":"Эта раковина странного оттенка, как будто чем-то заражена.","frame":"strange_shell","special":true,"carry":{"x":7,"y":0,"angle":0,"scale":1},"spawn":{"bird":{"crazy":[{"from":5,"to":50,"weight":0.15},{"from":50,"to":100,"weight":0.25},{"from":100,"to":-1,"weight":0.3}]},"egg":{"basic":{"weight":0.5}}}},{"id":"ice-shard","name":"Осколок льда","description":"Не тает на ладони. Холод морозной чайки.","frame":"ice_shard","special":true,"carry":{"x":5,"y":0,"angle":100,"scale":1.25},"spawn":{"bird":{"freeze":[{"from":5,"to":50,"weight":0.15},{"from":50,"to":100,"weight":0.25},{"from":100,"to":-1,"weight":0.3}]},"egg":{"basic":{"weight":0.5}}}},{"id":"mega-seed","name":"Мега-семя","description":"Странное светящееся семя из неизвестного измерения. Учёный-чайка утверждает, что оно содержит невероятное количество энергии.","frame":"mega_seed_1","special":true,"carry":{"x":5,"y":5,"angle":100,"scale":1.25},"spawn":{"bird":{"rik":[{"from":50,"to":100,"weight":0.2},{"from":100,"to":150,"weight":0.25},{"from":150,"to":-1,"weight":0.3}]},"egg":{"basic":{"weight":0.3}}}},{"id":"ectoplasm","name":"Эктоплазма","description":"Серебристая крупа с крыльев чайки-призрака. Держится в горсти, как дым.","frame":"ectoplasm","special":true,"carry":{"x":5,"y":0,"angle":10,"scale":1.15},"spawn":{"bird":{"ghost":[{"from":5,"to":50,"weight":0.15},{"from":50,"to":100,"weight":0.25},{"from":100,"to":-1,"weight":0.3}]},"egg":{"basic":{"weight":0.3}}}},{"id":"gunpowder","name":"Порох","description":"Порох из бомбы солдатской чайки. Сними бомбу прыжком, пока солдат её не сбросил.","frame":"gun_powder","special":true,"carry":{"x":0,"y":0,"angle":0,"scale":1},"spawn":{"egg":{"basic":{"weight":0.3}}}},{"id":"mutagen","name":"Мутаген","description":"Колба учёного. Лучше не разбивать над островом.","frame":"mutagen_1","special":true,"carry":{"x":12,"y":0,"angle":45,"scale":1.2},"spawn":{"bird":{"scientist":[{"from":50,"to":100,"weight":0.2},{"from":100,"to":150,"weight":0.25},{"from":150,"to":-1,"weight":0.3}]},"egg":{"basic":{"weight":0.3}}}},{"id":"stardust","name":"Звёздная пыль","description":"Сыпется со звездочёта. Одна из самых ценных крупиц в рецептах.","frame":"stardust","special":true,"carry":{"x":7,"y":0,"angle":15,"scale":1.3},"spawn":{"bird":{"evil_wizard":[{"from":50,"to":100,"weight":0.2},{"from":100,"to":150,"weight":0.25},{"from":150,"to":-1,"weight":0.3}]},"egg":{"basic":{"weight":0.3}}}},{"id":"golden-feather","name":"Золотое перо","description":"Перо золотой чайки. Блестит даже в трюме.","frame":"golden_feather","special":true,"carry":{"x":5,"y":3,"angle":-60,"scale":1.3},"spawn":{"bird":{"midas":[{"from":100,"to":150,"weight":0.2},{"from":150,"to":-1,"weight":0.3}]},"egg":{"basic":{"weight":0.1}}}}]}]],0,0,[],[],[]],[[[8,"quests",{"version":3,"quests":[{"id":"first-chest","title":"Находка из волн","description":"Эй, живой? Если читаешь это — тебе повезло больше, чем моим матросам. На этом острове ты долго не продержишься с пустыми карманами. Набей кошелёк, и я пришлю то, где сможешь хранить своё добро.\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":[{"type":"collect","coins":true,"count":25}],"config":{"coins":{"SPAWN":[{"weight":0.1}]}},"rewards":[{"type":"item","item":"chest","place":true}]},{"id":"craft-wardrobe","title":"Пиратский гардероб","description":"Хорошее начало! Но сундук ломится, а твои вещи киснут под солёным брызгом. На чайках переносится полно хлама. Надергай парусины да досок, я обучу тебя чертежу настоящего шкафа!\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":[{"type":"collect","items":[{"itemId":"plank","count":15},{"itemId":"canvas","count":10},{"itemId":"glass","count":6},{"itemId":"scrap","count":4}]}],"rewards":[{"type":"item","item":"wardrobe"}]},{"id":"craft-bed","title":"За облака","description":"Хороший моряк не заслуживает того, чтоб спать на песке! А ещё хороший моряк может подняться так высоко, что будет касаться облаков. Докажи, что ты хороший моряк!\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":[{"type":"height","height":100}],"rewards":[{"type":"item","item":"bed"}]},{"id":"craft-slots","title":"Удача Морского Дьявола","description":"Остров кажется пустым, но в глубине штормов спрятана магия. Пора проверить твою удачу! Добудь мне странных раковин и зловещей эктоплазмы — мы заставим саму судьбу крутиться в нашу пользу.\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":[{"type":"collect","items":[{"itemId":"scrap","count":10},{"itemId":"plank","count":10},{"itemId":"glass","count":10},{"itemId":"strange-shell","count":5},{"itemId":"ectoplasm","count":5},{"itemId":"mutagen","count":5},{"itemId":"golden-feather","count":1}]}],"rewards":[{"type":"item","item":"slots"}]},{"id":"ancestor-bones","title":"Мозги предков","description":"Проклятые чайки утащили ожившие мозги старого шамана Лоа. Без них магия острова угасает. Сними этих птиц с неба и верни мне мозги!\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":[{"type":"collect","itemId":"brain","count":10}],"config":{"resource":{"brain":{"spawn":{"bird":{"zombie":[{"weight":0.35}]}}}}},"rewards":[{"type":"artifact","artifact":"OldAnchor"}]},{"id":"ghost-fleet-echo","title":"Эхо призрачного флота","description":"Вижу туман на горизонте... Это призраки Летучего Голландца! Их капитан обронил древний свиток с рецептом артефакта, умеющего указывать путь сквозь проклятые воды. Капитан обронил, а я подобрал, хе-хе! Принеси мне обычный компас, и за небольшую плату я обменяю его на ценный артефакт.\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":[{"type":"collect","coins":true,"count":30,"items":[{"itemId":"Compass","count":1}]}],"config":{"artifact":{"Compass":{"spawn":{"bird":{"basic":[{"from":50,"weight":0.1}]},"egg":{"basic":{"weight":0.1}}}}}},"rewards":[{"type":"item","item":"lost-fleet-compass"}]},{"id":"steel-ice-storm","title":"Стальной и ледяной шторм","description":"Чтобы выковать оружие против чудовищ глубин, обычной стали мало. Нам нужен огонь пороха и холод проклятого льда. Принеси их мне, парень, пока туман не сгустился!\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":[{"type":"collect","items":[{"itemId":"ice-shard","count":8},{"itemId":"gunpowder","count":15},{"itemId":"scrap","count":10}]}],"rewards":[{"type":"item","item":"captains-spyglass"}]},{"id":"leviathan-blood","title":"Кровь Древнего Левиафана","description":"Оно пробуждается... Левиафан чешет спину о скалы нашего острова! Чтобы создать вещь, способную удержать монстра, мне нужен его испуг и твоя смелость. Добудь мне редких ингредиентов!\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":[{"type":"collect","items":[{"itemId":"mutagen","count":10},{"itemId":"mega-seed","count":5},{"itemId":"ectoplasm","count":5}]}],"rewards":[{"type":"item","item":"leviathan-fang"}]},{"id":"golden-firebird","title":"Перо Золотой Жар-Птицы","description":"Раз в тысячу лет над этим островом пролетает птица из чистейшего золота. Её перо — ключ к магии океанских вуду-владык. Взберись так высоко, как только сможешь, и забери его!\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":[{"type":"collect","itemId":"golden-feather","count":5}],"rewards":[{"type":"item","item":"stardust","count":5},{"type":"item","item":"leviathan-heart"}]},{"id":"lord-of-seven-seas","title":"Владыка Семи Морей","description":"Ты доказал, что достоин стать легендой. Пора снять проклятие с этого острова и стать настоящим Повелителем Морей. Скрафти легендарный артефакт и прими мою последнюю благодарность... Прощай, капитан!\n\n— К.","kind":"story","repeatable":false,"weight":3,"goal":[{"type":"craft","blueprintId":"sea-lord-trident","requireBlueprint":true}],"rewards":[{"type":"item","item":"stardust","count":10},{"type":"item","item":"mutagen","count":5},{"type":"item","item":"golden-feather","count":1}]},{"id":"old-longboat","title":"Старая шлюпка","description":"Прибой принёс обломки старой шлюпки. Мне срочно нужны ресурсы, чтоб подлатать её!\n\n— К.","kind":"side","repeatable":false,"weight":1,"skipCost":10,"goal":[{"type":"collect","items":[{"itemId":"plank","count":20},{"itemId":"canvas","count":10},{"itemId":"rope","count":10}]}],"rewards":[{"type":"artifact","artifact":"Spyglass"}]},{"id":"megalodon-archaeology","title":"Древняя археология","description":"Сегодня прибоем выбросило на пляж зуб мегалодона. У меня уже есть один такой, но для особого ожерелья нужно хотя бы три. Найди мне ещё один, и я щедро за него заплачу!\n\n— К.","kind":"side","repeatable":false,"weight":1,"skipCost":10,"goal":[{"type":"collect","itemId":"MegalodonTooth","count":1}],"rewards":[{"type":"coins","amount":50},{"type":"item","item":"kraken-tentacle"}],"config":{"artifact":{"MegalodonTooth":{"spawn":{"egg":{"basic":{"weight":0.15}}}}}}},{"id":"ice-breath-potion","title":"Зелье ледяного дыхания","description":"Жара на острове невыносимая. Мне нужен лёд, чтобы сварить освежающий напиток. Принеси мне ингредиенты для отвара!\n\n— К.","kind":"side","repeatable":false,"weight":1,"skipCost":10,"goal":[{"type":"collect","items":[{"itemId":"ice-shard","count":5},{"itemId":"mutagen","count":3},{"itemId":"ectoplasm","count":3}]}],"rewards":[{"type":"item","item":"golden-feather","count":1}]},{"id":"explosive-tricks","title":"Взрывные штучки","description":"Я понял, как можно пугать назойливых чаек! Самодельные петарды должны их отучить воровать у меня драгоценности! Принеси мне немного материалов, а я в долгу не останусь.\n\n— К.","kind":"side","repeatable":false,"weight":1,"skipCost":10,"goal":[{"type":"collect","items":[{"itemId":"gunpowder","count":25},{"itemId":"canvas","count":15},{"itemId":"scrap","count":15},{"itemId":"rope","count":10}]}],"rewards":[{"type":"item","item":"leviathan-anchor"}]},{"id":"strange-seeds","title":"Странные семена","description":"Я заметил в когтях чаек странные семена, я таких раньше не встречал. Добудь мне несколько, попробую их прорастить, может что и получится!\n\n— К.","kind":"side","repeatable":false,"weight":1,"skipCost":10,"goal":[{"type":"collect","itemId":"mega-seed","count":5}],"rewards":[{"type":"coins","amount":25}]}]}]],0,0,[],[],[]],[[{"name":"default_btn_disabled","rect":{"x":0,"y":0,"width":40,"height":40},"offset":{"x":0,"y":0},"originalSize":{"width":40,"height":40},"rotated":false,"capInsets":[12,12,12,12],"vertices":{"rawPosition":[-20,-20,0,20,-20,0,-20,20,0,20,20,0],"indexes":[0,1,2,2,1,3],"uv":[0,40,40,40,0,0,40,0],"nuv":[0,0,1,0,0,1,1,1],"minPos":{"x":-20,"y":-20,"z":0},"maxPos":{"x":20,"y":20,"z":0}},"packable":true,"pixelsToUnit":100,"pivot":{"x":0.5,"y":0.5},"meshType":0}],[7],0,[0],[6],[9]],[[[8,"birds",{"version":1,"birds":[{"id":"basic","name":"seagull","description":"Обычная чайка. Носит добычу в клешнях.","frame":"basic","speedMin":35,"speedMax":150,"scaleMin":1,"scaleMax":1.2,"captureSlow":0.3,"spawn":[{"from":0,"to":-1,"weight":1}]},{"id":"crazy","name":"crazy","description":"Сумасшедшая чайка. На захвате несёт пирата рывками.","frame":"crazy","speedMin":55,"captureSlow":0,"spawnGap":5,"grabSpeedScale":2,"vyRatio":0.5,"turnMin":0.3,"turnMax":1,"spawn":[{"from":5,"to":30,"weight":0.06},{"from":30,"to":-1,"weight":0.1}]},{"id":"zombie","name":"zombie","description":"Зомби-чайка. Когти отваливаются через мгновение после захвата.","frame":"zombie","speedMax":75,"captureSlow":0.5,"spawnGap":5,"minDelay":0.3,"maxDelay":1.5,"detachTilt":28,"spawn":[{"from":15,"to":50,"weight":0.06},{"from":50,"to":100,"weight":0.1},{"from":100,"to":-1,"weight":0.05}]},{"id":"rik","name":"rik","description":"Чайк